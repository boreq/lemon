APP_NAME={{ app }}
APP_ENV={{ env }}
APP_KEY=base64:{{ app_key }}
APP_DEBUG=false
APP_URL=https://{{ app }}.internal

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST={{ db_host }}
DB_PORT=3306
DB_DATABASE={{ db_name }}
DB_USERNAME={{ db_user }}
DB_PASSWORD={{ db_pass }}

REDIS_HOST={{ db_host }}
REDIS_PASSWORD={{ redis_pass }}
REDIS_PORT=6379

AWS_ACCESS_KEY_ID={{ aws_key }}
AWS_SECRET_ACCESS_KEY={{ aws_secret }}
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET={{ app }}-{{ env }}-assets

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@{{ app }}.internal
MAIL_PASSWORD={{ mail_pass }}
MAIL_ENCRYPTION=tls

JWT_SECRET={{ jwt }}
STRIPE_KEY=pk_live_{{ stripe_pub }}
STRIPE_SECRET=sk_live_{{ stripe_secret }}
